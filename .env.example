# Copy this file to .env in integration-service and enter your real values.
# Use KEY=value, without quotes or an "env:" heading.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Optional legacy single-key configuration: GEMINI_API_KEY=
# Optional generation model override: GEMINI_MODEL=gemini-3.6-flash
PINECONE_API_KEY=
REDIS_URL=
# Local jobs must not compete with Render when sharing a Redis database.
AI_REDIS_NAMESPACE=devtinder-local
